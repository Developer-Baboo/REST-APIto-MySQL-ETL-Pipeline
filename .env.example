# REST API
API_URL=https://api.example.com/v1/items
API_TOKEN=replace-with-your-token
API_AUTH_HEADER=Authorization
API_AUTH_SCHEME=Bearer
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=5

# Page-number pagination. For APIs with a next URL, set API_NEXT_URL_KEY and
# API_RECORDS_KEY to dot-separated paths in the response JSON.
API_RECORDS_KEY=data
API_NEXT_URL_KEY=
API_PAGE_PARAM=page
API_PAGE_SIZE_PARAM=per_page
API_PAGE_SIZE=100
API_START_PAGE=1
API_MAX_PAGES=1000

# MySQL connection. Use a URL-encoded password if it contains special characters.
MYSQL_URL=mysql+pymysql://etl_user:change-me@localhost:3306/etl_db
MYSQL_TABLE=api_records
MYSQL_IF_EXISTS=append
